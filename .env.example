# ============================================================
# HRIS Potensi Creative — Environment Variables
# Copy to `.env.local` (local) / set in your host's env (prod).
# ============================================================

# ---- Database (local Postgres / Docker) ----
# Local dev uses a Docker Postgres. See docker-compose.yml.
# For Supabase use the pooled connection string (see SUPABASE.md):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hris?schema=public

# ---- NextAuth (REQUIRED in production) ----
# Generate: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=
# NextAuth v5 also accepts NEXTAUTH_SECRET as an alias if your host uses it.
NEXTAUTH_SECRET=

# ---- Google OAuth (optional; login works via PIN without it) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cron jobs (payout-run, billing-close, telegram-poll, ...) ----
# Required in production to protect POST /api/jobs/run and /api/telegram/poll.
CRON_SECRET=

# ---- Webhook ingest (stream.online / stream.offline) ----
WEBHOOK_SECRET=

# ---- OpenRouter (optional LLM converter; also configurable per-tenant in Admin) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Telegram bot (optional; also configurable per-tenant in Admin) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- Host / deployment ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
